#version 460
// taa.comp - temporales Anti-Aliasing mit Varianz-Clipping
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "common.glsl"
layout(set = 0, binding = 1) uniform sampler2D tHdr;
layout(set = 0, binding = 2) uniform sampler2D tHist;   // linear
layout(set = 0, binding = 3) uniform sampler2D tMotion;
layout(set = 0, binding = 4) uniform sampler2D tND;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D oOut;

vec3 tm(vec3 c) { return c / (1.0 + luma(c)); }
vec3 itm(vec3 c) { return c / max(1.0 - luma(c), 1e-4); }

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy); ivec2 sz = ivec2(F.res.xy);
    if (pix.x >= sz.x || pix.y >= sz.y) return;
    vec3 cur = tm(texelFetch(tHdr, pix, 0).rgb);
    vec3 m1 = vec3(0.0), m2 = vec3(0.0); float best = 1e9; ivec2 bq = pix;
    for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
        ivec2 q = clamp(pix + ivec2(x, y), ivec2(0), sz - 1);
        vec3 c = tm(texelFetch(tHdr, q, 0).rgb); m1 += c; m2 += c * c;
        float z = texelFetch(tND, q, 0).z; if (z < best) { best = z; bq = q; }
    }
    m1 /= 9.0; m2 /= 9.0; vec3 sd = sqrt(max(m2 - m1 * m1, 0.0));
    vec2 mv = texelFetch(tMotion, bq, 0).xy;
    vec2 puv = (vec2(pix) + 0.5) * F.res.zw + mv;
    vec3 outc = cur;
    if (puv.x > 0.0 && puv.y > 0.0 && puv.x < 1.0 && puv.y < 1.0 && F.misc.x > 0.5) {
        vec3 hist = tm(textureLod(tHist, puv, 0.0).rgb);
        vec3 lo = m1 - sd * 1.25, hi = m1 + sd * 1.25;
        hist = clamp(hist, lo, hi);
        float speed = length(mv * F.res.xy);
        float a = mix(0.06, 0.16, clamp(speed / 12.0, 0.0, 1.0));
        outc = mix(hist, cur, a);
    }
    imageStore(oOut, pix, vec4(itm(outc), 1.0));
}
