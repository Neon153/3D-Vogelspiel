#version 460
// composite.comp - Albedo * (direkt + indirekt) + Spiegelungen, danach Nebel
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "common.glsl"
layout(set = 0, binding = 1) uniform sampler2D tAlbedo;
layout(set = 0, binding = 2) uniform sampler2D tDirect;
layout(set = 0, binding = 3) uniform sampler2D tIndirect;
layout(set = 0, binding = 4) uniform sampler2D tSpec;
layout(set = 0, binding = 5) uniform sampler2D tFog;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D oHdr;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy); ivec2 sz = ivec2(F.res.xy);
    if (pix.x >= sz.x || pix.y >= sz.y) return;
    vec3 alb = texelFetch(tAlbedo, pix, 0).rgb; alb *= alb;
    vec3 c = alb * (texelFetch(tDirect, pix, 0).rgb + texelFetch(tIndirect, pix, 0).rgb) + texelFetch(tSpec, pix, 0).rgb;
    vec4 fg = texelFetch(tFog, pix, 0);
    c = c * fg.a + fg.rgb;
    if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
    imageStore(oHdr, pix, vec4(clamp(c, vec3(0.0), vec3(4000.0)), 1.0));
}
